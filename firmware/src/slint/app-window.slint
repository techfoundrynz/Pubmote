// Top-level PubRemote Slint UI.
//
// Holds every screen ported from the LVGL/SquareLine UI and switches between
// them based on `UiState.screen`. All dynamic data and actions are funnelled
// through the `UiState` global so the C++ side has a single, stable surface to
// bind against (set properties, connect callbacks) — analogous to how the LVGL
// code updated named widgets and registered event callbacks.

import { Theme } from "ui/theme.slint";
import { Navigation } from "ui/navigation-focus.slint";
export { Theme, Navigation }
import "../../assets/Saira-SemiBold.ttf";
import "../../assets/JetBrainsMono-Medium.ttf";
import "../../assets/lucide-icons.ttf";
import { SplashScreen } from "ui/splash.slint";
import { StatsScreen } from "ui/stats.slint";
import { MenuScreen } from "ui/menu.slint";
import { SettingsScreen } from "ui/settings.slint";
import { PairingScreen, DiscoveredDevice } from "ui/pairing.slint";
import { InputCalibrationScreen } from "ui/input-calibration.slint";
import { AboutScreen, StatEntry } from "ui/about.slint";
import { ImuCalibrationScreen } from "ui/imu-calibration.slint";
import { UpdateScreen } from "ui/update.slint";
import { WifiScreen, WifiNetwork } from "ui/wifi.slint";
import { ChargeScreen } from "ui/charge.slint";
import { FpsOverlay } from "ui/fps-overlay.slint";
import { ColorSliderGenerator } from "ui/color-slider.slint";
export { ColorSliderGenerator }
import { ArcGauge } from "ui/arc-gauge.slint";
import { ProcessingOverlay } from "ui/processing-overlay.slint";
import { ConfirmDialog } from "ui/confirm-dialog.slint";
import { BoardsScreen, PairedBoard } from "ui/boards.slint";
import { ExtrasScreen } from "ui/extras.slint";
import { DisplayTestScreen, DisplayTouchPoint } from "ui/display-test.slint";
import { GamesScreen } from "ui/games.slint";
import { GameScreen, GameDraw, GamePosition } from "ui/game.slint";
import { EdgeFade } from "ui/edge-fade.slint";

export enum Screen {
    splash,
    stats,
    menu,
    settings,
    pairing,
    input-calibration,
    about,
    update,
    wifi,
    charge,
    imu-calibration,
    boards,
    games,
    game,
    extras,
    display-test,
}

// Single binding surface for the firmware.
export global UiState {
    in-out property <bool> display-test-hardware-input: false;
    in-out property <[DisplayTouchPoint]> display-test-points;
    in-out property <string> display-test-coordinates: "Touch anywhere";
    in-out property <string> operation-error: "";
    in property <bool> processing: false;
    in property <string> processing-message: "Working...";
    in-out property <Screen> screen: Screen.splash;
    in-out property <int> fps: 0;
    in property <bool> show-fps: false;
    // Where a frame goes, shown under the FPS counter when show-fps is set.
    in property <int> perf-prepare-ms: 0;
    in property <int> perf-render-ms: 0;
    in property <int> perf-flush-ms: 0;
    in property <int> perf-dirty-pct: 0;

    // --- Stats (ui_StatsScreen) ---
    in property <string> speed: "0.0";
    in property <string> speed-unit: "KPH";
    in property <float> speed-fraction: 0;
    in property <float> utilization-fraction: 0;
    in property <bool> left-pad: false;
    in property <bool> right-pad: false;
    in property <int> remote-battery: 100;
    in property <bool> remote-charging: false;
    in property <string> secondary-stat-left-value: "";
    in property <string> secondary-stat-left-label: "";
    in property <string> connection-state-label: "Disconnected";
    in property <bool> is-connected: false;
    in property <int> connection-state: 0;
    in property <string> board-battery: "0%";
    in property <int> rssi: -100;
    in property <bool> pocket-mode-active: false;
    in property <bool> lights-on: false;
    in property <string> board-state-message: "";
    in property <int> vehicle-type: 0;

    // --- Menu (ui_MenuScreen) ---
    in property <bool> menu-show-connect: false;
    in property <string> menu-connect-label: "Connect";
    in property <string> dimming-mode-label: "";
    in property <bool> dimming-mode-supported: false;
    in property <string> led-mode-label: "";
    in property <bool> led-mode-supported: false;
    in-out property <int> scroll-offset-y: 0;

    // --- Settings (ui_SettingsScreen) ---
    in-out property <float> brightness: 128;
    in-out property <int> double-press-index: 1;
    in-out property <int> rotation-index: 0;
    in-out property <int> auto-off-index: 0;
    in-out property <int> temp-units-index: 0;
    in-out property <int> distance-units-index: 0;
    in-out property <int> startup-sound-index: 0;

    // Dropdown option labels, populated from settings.c
    in property <[string]> double-press-options: [];
    in property <[string]> rotation-options: [];
    in property <[string]> auto-off-options: [];
    in property <[string]> temp-units-options: [];
    in property <[string]> distance-units-options: [];
    in property <[string]> startup-sound-options: [];

    in-out property <float> theme-h: 0;
    in-out property <float> theme-s: 100;
    in-out property <float> theme-l: 50;

    // --- Pairing (ui_PairingScreen) ---
    in property <string> pairing-code: "0000";
    in property <string> pairing-action-text: "Cancel";
    in property <string> pairing-status: "Searching for board...";
    in-out property <bool> is-ble-scan: false;
    in-out property <string> ble-scan-error: "";
    in-out property <[DiscoveredDevice]> discovered-devices: [];
    callback select-device(int);
    callback retry-ble-scan();

    // --- Boards (Paired Boards list) ---
    in property <[PairedBoard]> paired-boards: [];
    callback select-board(int);
    callback delete-board(int);
    callback boards-back();
    callback boards-pair-new();

    // --- Input Calibration (ui_InputCalibrationScreen) ---
    in property <string> input-calibration-readout: "X: 0.0 | Y: 0.0";
    in property <string> input-calibration-step: "Press start to begin calibration";
    in property <string> input-calibration-primary-text: "Start";
    in property <bool> input-calibration-measuring: false;
    in property <float> joystick-x: 0;
    in property <float> joystick-y: 0;
    in property <bool> show-expo-slider: false;
    in property <bool> show-invert-switch: false;
    in-out property <float> expo-value: 1.0;
    in-out property <bool> invert-x: false;
    in-out property <bool> invert-y: false;

    // --- About (ui_AboutScreen) ---
    in property <string> version-info: "Version: unknown\nType: unknown\nHash: unknown";
    in property <[StatEntry]> about-stats: [];
    in property <bool> shipping-mode-supported: false;
    in property <bool> shipping-mode-available: false;

    // --- Extras and Arcade (five taps on the About version) ---
    in property <bool> button-supported: false;
    in property <[string]> installed-games: [];
    in property <[GameDraw]> game-draw: [];
    in property <[GamePosition]> game-positions: [];
    in property <string> game-error: "";
    callback open-games();
    callback games-launch(int);
    callback games-back();
    callback game-tick();
    callback game-event(int, float, float);
    callback game-back();

    // --- IMU Calibration ---
    in property <float> imu-calibration-accel-x: 0.0;
    in property <float> imu-calibration-accel-y: 0.0;
    in property <float> imu-calibration-accel-z: 0.0;
    in property <float> imu-calibration-gyro-x: 0.0;
    in property <float> imu-calibration-gyro-y: 0.0;
    in property <float> imu-calibration-gyro-z: 0.0;
    in property <string> imu-calibration-accel-text: "A: X=0.00 Y=0.00 Z=0.00";
    in property <string> imu-calibration-gyro-text: "G: X=0.00 Y=0.00 Z=0.00";
    in property <string> imu-calibration-event-text: "None";
    in property <bool> imu-calibration-enabled: false;
    in property <bool> imu-supported: false;
    in property <bool> joystick-supported: false;
    in property <bool> joystick-x-supported: false;
    in property <bool> joystick-y-supported: false;
    in property <bool> imu-calibration-invert-x: false;
    in property <bool> imu-calibration-invert-y: false;
    in property <bool> imu-calibration-swap-xy: false;
    in property <string> imu-calibration-step-text: "";
    in property <string> imu-calibration-primary-button-text: "Next";
    in property <bool> imu-calibration-show-axis-controls: false;
    callback imu-calibration-calibrate-level();
    callback imu-calibration-toggle-invert-x();
    callback imu-calibration-toggle-invert-y();
    callback imu-calibration-toggle-swap-xy();
    callback imu-calibration-primary();

    // --- Update (ui_UpdateScreen) ---
    in property <string> update-body: "Click next to scan for networks";
    in property <bool> update-show-dropdown: false;
    in property <[string]> updates: [];
    in property <string> update-primary-text: "Next";
    in property <bool> update-primary-enabled: true;

    // --- Wi-Fi and reusable text input ---
    in property <[WifiNetwork]> wifi-networks: [];
    in property <string> wifi-status: "Scanning pauses the board connection.";
    in property <string> wifi-saved: "";
    in property <bool> wifi-busy: false;
    in property <bool> wifi-editing: false;
    in property <[string]> wifi-keys: [];
    in property <string> wifi-value: "";
    in property <string> wifi-masked-value: "";
    in property <string> wifi-heading: "";
    in property <string> wifi-mode-label: "123";
    in property <bool> wifi-secret: false;
    in-out property <bool> wifi-revealed: false;
    callback open-wifi();
    callback wifi-back();
    callback wifi-scan();
    callback wifi-select(int);
    callback wifi-connect-saved();
    callback wifi-forget();
    callback wifi-manual();
    callback wifi-key(int);
    callback wifi-mode();
    callback wifi-done();
    callback wifi-cancel();

    // --- Charge (ui_ChargeScreen) ---
    in property <int> charge-percent: 0;
    in property <string> charge-label: "Charging";
    in property <string> charge-time-estimate: "";

    // --- Boot notice (set by firmware when recovering from a crash) ---
    in-out property <string> boot-notice: "";
    in-out property <bool> calibration-prompt: false;

    // --- Confirm Dialog ---
    in-out property <bool> show-confirm-dialog: false;
    in-out property <string> confirm-dialog-title: "";
    in-out property <string> confirm-dialog-message: "";
    in-out property <string> confirm-dialog-confirm-text: "Confirm";
    in-out property <string> confirm-dialog-cancel-text: "Cancel";
    in-out property <string> confirm-dialog-variant: "standard";
    in-out property <string> confirm-dialog-cancel-variant: "secondary";
    in-out property <string> confirm-dialog-cancel-button-color: "standard";
    in-out property <string> confirm-dialog-confirm-button-variant: "primary";
    in-out property <bool> confirm-dialog-show-cancel: true;

    // --- Actions (the firmware connects these) ---
    callback screen-changed(Screen);
    callback splash-exit();
    callback charge-poll();
    callback charge-tapped();
    callback stats-swiped-down();
    callback secondary-stat-left-clicked();
    callback board-battery-clicked();
    // Menu
    callback menu-back();
    callback menu-connect();
    callback menu-pocket-mode();
    callback menu-toggle-dimming();
    callback menu-toggle-led();
    callback open-settings();
    callback open-input-calibration();
    callback open-pairing();
    callback open-about();
    callback menu-shutdown();
    // Settings
    callback settings-save();
    callback settings-changed();
    // Pairing
    callback pairing-action();
    // Input Calibration
    callback input-calibration-primary();
    callback input-calibration-secondary();
    // About
    callback about-check-updates();
    callback about-back();
    callback about-refresh();
    callback open-extras();
    callback extras-back();
    callback extras-refresh();
    callback extras-factory-reset();
    callback extras-shipping-mode();
    // IMU Calibration
    callback open-imu-calibration();
    callback imu-calibration-back();
    // Update
    callback update-primary();
    callback update-secondary();
    callback update-selected(int);
    // Confirm Dialog
    callback confirm-dialog-accepted();
    callback confirm-dialog-rejected();
}

export component AppWindow inherits Window {
    // Default to the Theme.panel-width / Theme.panel-height; dynamically sized at runtime.
    width: Theme.panel-width;
    height: Theme.panel-height;
    background: Theme.bg;
    title: "PubRemote";
    // Must match the TTF's family name exactly, or the compiler embeds the
    // host system font as the default instead
    default-font-family: "Saira Thin SemiBold";

    Timer {
        interval: 100ms;
        running: true;
        triggered => { UiState.charge-poll(); }
    }

    Timer {
        interval: 1000ms;
        running: UiState.screen == Screen.about;
        triggered => { UiState.about-refresh(); }
    }

    Timer {
        interval: 1000ms;
        running: UiState.screen == Screen.extras;
        triggered => { UiState.extras-refresh(); }
    }

    property <Screen> active-screen: UiState.screen;
    property <Screen> previous-screen: Screen.splash;
    property <bool> is-animating: false;
    property <bool> screen-loaded: true;

    // Animated viewport position in screen units. Screens are positioned
    // relative to this, so during a transition both the incoming and the
    // outgoing screen genuinely slide while staying fully opaque. All screens
    //
    // Viewport layout grid:
    // Y= 1:  [splash/charge] (X=0)
    // Y= 0:  [stats] (X=0)
    // Y=-1:  [menu] (X=0)  ->  [settings/calibration/pairing/about] (X=1)  ->  [update] (X=2)
    // Live stats->menu drag, as a fraction of the screen height (0 .. -1).
    // Held at its last value after a committing release until the screen
    // change from C++ lands, so the view does not bounce in between.
    property <float> view-drag: 0.0;
    property <bool> view-dragging: false;
    // Scaled to the remaining distance on drag release so the snap keeps the
    // finger's apparent velocity instead of restarting a full-length animation
    property <duration> snap-duration: 250ms;
    property <float> view-x: screen-x(root.active-screen);
    property <float> view-y: screen-y(root.active-screen) + root.view-drag;
    animate view-x, view-y {
        duration: (root.view-dragging ||
            root.active-screen == Screen.splash ||
            root.active-screen == Screen.charge ||
            root.previous-screen == Screen.splash ||
            root.previous-screen == Screen.charge) ? 0ms : root.snap-duration;
        easing: ease-out;
    }

    pure function screen-x(s: Screen) -> int {
        if (s == Screen.settings) { return 1; }
        if (s == Screen.wifi) { return 1; }
        if (s == Screen.input-calibration) { return 1; }
        if (s == Screen.pairing) { return 2; }
        if (s == Screen.about) { return 1; }
        if (s == Screen.imu-calibration) { return 1; }
        if (s == Screen.boards) { return 1; }
        if (s == Screen.update) { return 2; }
        if (s == Screen.extras) { return 2; }
        if (s == Screen.display-test) { return 3; }
        if (s == Screen.games) { return 3; }
        if (s == Screen.game) { return 4; }
        return 0;
    }

    pure function screen-y(s: Screen) -> int {
        if (s == Screen.splash || s == Screen.charge) { return 1; }
        if (s == Screen.stats) { return 0; }
        return -1;
    }

    changed active-screen => {
        if self.active-screen == Screen.display-test {
            UiState.display-test-points = [];
            UiState.display-test-coordinates = "Touch anywhere";
            UiState.display-test-hardware-input = false;
        }
        Navigation.active = false;
        // Clear outgoing control focus and keep receiving the first input.
        navigation-root.focus();
        root.view-dragging = false;
        if (root.view-drag == 0) {
            // Not a drag commit; use the full-length transition
            root.snap-duration = 250ms;
        }
        root.view-drag = 0;
        if (self.active-screen == Screen.stats) {
            root.menu-focus-index = -1;
            UiState.scroll-offset-y = 0;
        }
        root.screen-loaded = false;
        root.is-animating = false;
        root.is-animating = true;
        UiState.show-confirm-dialog = false;
        UiState.screen-changed(self.active-screen);
    }

    property <bool> watch-confirm-dialog: UiState.show-confirm-dialog;
    changed watch-confirm-dialog => {
        if (!self.watch-confirm-dialog) {
            // Reset every shared option on close, including single-button alerts.
            UiState.confirm-dialog-title = "";
            UiState.confirm-dialog-message = "";
            UiState.confirm-dialog-confirm-text = "Confirm";
            UiState.confirm-dialog-cancel-text = "Cancel";
            UiState.confirm-dialog-variant = "standard";
            UiState.confirm-dialog-cancel-variant = "secondary";
            UiState.confirm-dialog-cancel-button-color = "standard";
            UiState.confirm-dialog-confirm-button-variant = "primary";
            UiState.confirm-dialog-show-cancel = true;
        }
    }

    Timer {
        interval: 20ms;
        running: !root.screen-loaded;
        triggered => {
            root.screen-loaded = true;
        }
    }

    Timer {
        interval: 250ms;
        running: root.is-animating;
        triggered => {
            root.is-animating = false;
            root.previous-screen = root.active-screen;
        }
    }

    Timer {
        interval: 1000ms;
        running: active-screen == Screen.splash;
        triggered => {
            UiState.splash-exit();
        }
    }

    property <bool> navigation-modal: UiState.show-confirm-dialog || UiState.boot-notice != ""
        || UiState.calibration-prompt || UiState.operation-error != "";
    property <bool> navigation-blocked: UiState.processing || root.is-animating;
    property <bool> root-navigation-active: (UiState.screen == Screen.stats || UiState.screen == Screen.game
        || UiState.screen == Screen.display-test)
        && !root.navigation-modal && !root.navigation-blocked;
    changed root-navigation-active => {
        if (root.root-navigation-active) {
            if (UiState.screen == Screen.game) { Navigation.active = false; }
            navigation-root.focus();
        }
    }
    changed navigation-modal => { Navigation.modal = root.navigation-modal; }
    changed navigation-blocked => { Navigation.blocked = root.navigation-blocked; }
    init => {
        Navigation.modal = root.navigation-modal;
        Navigation.blocked = root.navigation-blocked;
    }

    // All screen controls bubble the double-click/Escape gesture here.
    property <int> menu-focus-index: -1;
    navigation-root := FocusScope {
    width: 100%; height: 100%;
    focus-on-tab-navigation: false;
    // The invisible event scope receives input while controls remain unfocused.
    init => { self.focus(); }
    capture-key-pressed(event) => {
        if (UiState.processing || root.is-animating) { return accept; }
        // Gameplay bypasses control focus. Hardware stick directions already
        // go straight to Lua; keyboard/simulator directions use the same events.
        if (UiState.screen == Screen.game && !root.navigation-modal) {
            if (event.text == Key.Return) { UiState.game-event(0, 0, 0); return accept; }
            if (event.text == Key.UpArrow) { UiState.game-event(1, 0, 0); return accept; }
            if (event.text == Key.DownArrow) { UiState.game-event(2, 0, 0); return accept; }
            if (event.text == Key.LeftArrow) { UiState.game-event(3, 0, 0); return accept; }
            if (event.text == Key.RightArrow) { UiState.game-event(4, 0, 0); return accept; }
            if (event.text == Key.Tab || event.text == Key.Backtab) { return accept; }
            return reject;
        }
        if (!Navigation.active && (event.text == Key.Tab || event.text == Key.Backtab
            || event.text == Key.UpArrow || event.text == Key.DownArrow
            || event.text == Key.LeftArrow || event.text == Key.RightArrow
            || event.text == Key.Return || event.text == Key.Escape)) {
            Navigation.active = true;
            // Allow Back to work immediately, but use other first inputs only
            // to reveal the screen/dialog's default focus on the next UI tick.
            if (event.text != Key.Escape) { return accept; }
        }
        reject
    }
    key-pressed(event) => {
        if (event.text != Key.Escape) { return reject; }
        if (UiState.operation-error != "") { UiState.operation-error = ""; }
        else if (UiState.boot-notice != "") { UiState.boot-notice = ""; }
        else if (UiState.calibration-prompt) { UiState.calibration-prompt = false; }
        else if (UiState.show-confirm-dialog) {
            if (UiState.confirm-dialog-show-cancel) { UiState.confirm-dialog-rejected(); }
        }
        else if (UiState.screen == Screen.menu) { UiState.menu-back(); }
        else if (UiState.screen == Screen.settings) { UiState.settings-save(); }
        else if (UiState.screen == Screen.input-calibration) { UiState.input-calibration-secondary(); }
        else if (UiState.screen == Screen.imu-calibration) { UiState.imu-calibration-back(); }
        else if (UiState.screen == Screen.pairing) { UiState.pairing-action(); }
        else if (UiState.screen == Screen.boards) { UiState.boards-back(); }
        else if (UiState.screen == Screen.about) { UiState.about-back(); }
        else if (UiState.screen == Screen.extras) { UiState.extras-back(); }
        else if (UiState.screen == Screen.display-test) { UiState.screen = Screen.extras; }
        else if (UiState.screen == Screen.games) { UiState.games-back(); }
        else if (UiState.screen == Screen.game) { UiState.game-back(); }
        else if (UiState.screen == Screen.update) { UiState.update-secondary(); }
        else if (UiState.screen == Screen.wifi) {
            if (UiState.wifi-editing) { UiState.wifi-cancel(); }
            else { UiState.wifi-back(); }
        }
        else if (UiState.screen == Screen.charge) { UiState.charge-tapped(); }
        else if (UiState.screen == Screen.stats && UiState.double-press-index == 1) { UiState.stats-swiped-down(); }
        return accept;
    }

    if UiState.screen == Screen.splash || root.previous-screen == Screen.splash: SplashScreen {
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.splash) - root.view-x) * self.width;
        y: (screen-y(Screen.splash) - root.view-y) * self.height;
        clicked => { UiState.splash-exit(); }
    }

    if UiState.screen == Screen.stats || root.previous-screen == Screen.stats: StatsScreen {
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.stats) - root.view-x) * self.width;
        // Pinned while the menu slides over it (sheet style) instead of panning away
        y: Math.min(0.0, screen-y(Screen.stats) - root.view-y) * self.height;
        speed: UiState.speed;
        speed-unit: UiState.speed-unit;
        speed-fraction: UiState.speed-fraction;
        utilization-fraction: UiState.utilization-fraction;
        left-pad: UiState.left-pad;
        right-pad: UiState.right-pad;
        remote-battery: UiState.remote-battery;
        remote-charging: UiState.remote-charging;
        secondary-stat-left-value: UiState.secondary-stat-left-value;
        secondary-stat-left-label: UiState.secondary-stat-left-label;
        connection-state-label: UiState.connection-state-label;
        is-connected: UiState.is-connected;
        board-battery: UiState.board-battery;
        rssi: UiState.rssi;
        // 1 = CONNECTING, 3 = RECONNECTING (ConnectionState enum)
        searching: UiState.connection-state == 1 || UiState.connection-state == 3;
        pocket-mode-active: UiState.pocket-mode-active;
        lights-on: UiState.lights-on;
        board-state-message: UiState.board-state-message;
        vehicle-type: UiState.vehicle-type;
        menu-drag(d) => {
            if (root.active-screen == Screen.stats) {
                root.view-dragging = true;
                root.view-drag = -Math.max(0.0, Math.min(1.0, d / self.height));
            }
        }
        menu-drag-end(d) => {
            root.view-dragging = false;
            if (root.active-screen == Screen.stats && d > 40px) {
                root.snap-duration = (1.0 + root.view-drag) * 250ms;
                UiState.stats-swiped-down();
            } else {
                root.snap-duration = -root.view-drag * 250ms;
                root.view-drag = 0;
            }
        }
        menu-drag-cancel => {
            root.view-dragging = false;
            root.snap-duration = -root.view-drag * 250ms;
            root.view-drag = 0;
        }
        secondary-stat-left-clicked => { UiState.secondary-stat-left-clicked(); }
        board-battery-clicked => { UiState.board-battery-clicked(); }
    }

    if UiState.screen == Screen.menu || root.previous-screen == Screen.menu
        || root.view-dragging || root.view-drag != 0: MenuScreen {
        navigation-active: UiState.screen == Screen.menu;
        focus-index <=> root.menu-focus-index;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.menu) - root.view-x) * self.width;
        y: (screen-y(Screen.menu) - root.view-y) * self.height;
        show-connect: UiState.menu-show-connect;
        connect-label: UiState.menu-connect-label;
        pocket-mode-active: UiState.pocket-mode-active;
        dimming-mode-label: UiState.dimming-mode-label;
        dimming-mode-supported: UiState.dimming-mode-supported;
        led-mode-label: UiState.led-mode-label;
        led-mode-supported: UiState.led-mode-supported;
        scroll-offset-y <=> UiState.scroll-offset-y;
        imu-supported: UiState.imu-supported;
        joystick-supported: UiState.joystick-supported;
        back => { UiState.menu-back(); }
        connect => { UiState.menu-connect(); }
        pocket-mode => { UiState.menu-pocket-mode(); }
        toggle-dimming => { UiState.menu-toggle-dimming(); }
        toggle-led => { UiState.menu-toggle-led(); }
        settings => { UiState.open-settings(); }
        calibration => { UiState.open-input-calibration(); }
        pairing => { UiState.open-pairing(); }
        about => { UiState.open-about(); }
        wifi => { UiState.open-wifi(); }
        imu-calibration => { UiState.open-imu-calibration(); }
        shutdown => { UiState.menu-shutdown(); }
    }

    // Sheet edge under the menu while it slides over stats
    if root.view-dragging || root.view-drag != 0: EdgeFade {
        y: (screen-y(Screen.menu) + 1 - root.view-y) * root.height;
    }

    if UiState.screen == Screen.settings || root.previous-screen == Screen.settings: SettingsScreen {
        navigation-active: UiState.screen == Screen.settings;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.settings) - root.view-x) * self.width;
        y: (screen-y(Screen.settings) - root.view-y) * self.height;
        brightness <=> UiState.brightness;
        double-press-index <=> UiState.double-press-index;
        rotation-index <=> UiState.rotation-index;
        auto-off-index <=> UiState.auto-off-index;
        temp-units-index <=> UiState.temp-units-index;
        distance-units-index <=> UiState.distance-units-index;
        startup-sound-index <=> UiState.startup-sound-index;

        double-press-options: UiState.double-press-options;
        rotation-options: UiState.rotation-options;
        auto-off-options: UiState.auto-off-options;
        temp-units-options: UiState.temp-units-options;
        distance-units-options: UiState.distance-units-options;
        startup-sound-options: UiState.startup-sound-options;

        theme-h <=> UiState.theme-h;
        theme-s <=> UiState.theme-s;
        theme-l <=> UiState.theme-l;
        save => { UiState.settings-save(); }

        changed brightness => { UiState.settings-changed(); }
        changed theme-h => { UiState.settings-changed(); }
        changed theme-s => { UiState.settings-changed(); }
        changed theme-l => { UiState.settings-changed(); }
    }

    if UiState.screen == Screen.pairing || root.previous-screen == Screen.pairing: PairingScreen {
        navigation-active: UiState.screen == Screen.pairing;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.pairing) - root.view-x) * self.width;
        y: (screen-y(Screen.pairing) - root.view-y) * self.height;
        pairing-code: UiState.pairing-code;
        action-text: UiState.pairing-action-text;
        pairing-status: UiState.pairing-status;
        action => { UiState.pairing-action(); }
        is-ble-scan: UiState.is-ble-scan;
        scan-error: UiState.ble-scan-error;
        discovered-devices: UiState.discovered-devices;
        select-device(idx) => { UiState.select-device(idx); }
        retry-scan => { UiState.retry-ble-scan(); }
    }

    if UiState.screen == Screen.boards || root.previous-screen == Screen.boards: BoardsScreen {
        navigation-active: UiState.screen == Screen.boards;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.boards) - root.view-x) * self.width;
        y: (screen-y(Screen.boards) - root.view-y) * self.height;
        boards: UiState.paired-boards;
        select-board(i) => { UiState.select-board(i); }
        delete-board(i) => { UiState.delete-board(i); }
        back => { UiState.boards-back(); }
        pair-new => { UiState.boards-pair-new(); }
    }

    if UiState.screen == Screen.input-calibration || root.previous-screen == Screen.input-calibration: InputCalibrationScreen {
        navigation-active: UiState.screen == Screen.input-calibration;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.input-calibration) - root.view-x) * self.width;
        y: (screen-y(Screen.input-calibration) - root.view-y) * self.height;
        readout-text: UiState.input-calibration-readout;
        step-text: UiState.input-calibration-step;
        primary-text: UiState.input-calibration-primary-text;
        measuring: UiState.input-calibration-measuring;
        joystick-x: UiState.joystick-x;
        joystick-y: UiState.joystick-y;
        show-expo-slider: UiState.show-expo-slider;
        show-invert-switch: UiState.show-invert-switch;
        x-axis-supported: UiState.joystick-x-supported;
        y-axis-supported: UiState.joystick-y-supported;
        expo-value <=> UiState.expo-value;
        invert-x <=> UiState.invert-x;
        invert-y <=> UiState.invert-y;
        primary => { UiState.input-calibration-primary(); }
        secondary => { UiState.input-calibration-secondary(); }
    }

    if UiState.screen == Screen.about || root.previous-screen == Screen.about: AboutScreen {
        navigation-active: UiState.screen == Screen.about;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.about) - root.view-x) * self.width;
        y: (screen-y(Screen.about) - root.view-y) * self.height;
        version-info: UiState.version-info;
        stats: UiState.about-stats;
        check-updates => { UiState.about-check-updates(); }
        back => { UiState.about-back(); }
        secret => { UiState.open-extras(); }
    }

    if UiState.screen == Screen.extras || root.previous-screen == Screen.extras: ExtrasScreen {
        navigation-active: UiState.screen == Screen.extras;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.extras) - root.view-x) * self.width;
        y: (screen-y(Screen.extras) - root.view-y) * self.height;
        shipping-mode-supported: UiState.shipping-mode-supported;
        shipping-mode-available: UiState.shipping-mode-available;
        factory-reset => { UiState.extras-factory-reset(); }
        shipping-mode => { UiState.extras-shipping-mode(); }
        arcade => { UiState.open-games(); }
        display-test => { UiState.screen = Screen.display-test; }
        back => { UiState.extras-back(); }
    }

    if UiState.screen == Screen.display-test || root.previous-screen == Screen.display-test: DisplayTestScreen {
        hardware-input: UiState.display-test-hardware-input;
        points: UiState.display-test-points;
        coordinates: UiState.display-test-coordinates;
        width: 100%; height: 100%;
        x: (screen-x(Screen.display-test) - root.view-x) * self.width;
        y: (screen-y(Screen.display-test) - root.view-y) * self.height;
        active: UiState.screen == Screen.display-test;
        back => { UiState.screen = Screen.extras; }
    }

    if UiState.screen == Screen.games || root.previous-screen == Screen.games: GamesScreen {
        navigation-active: UiState.screen == Screen.games;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.games) - root.view-x) * self.width;
        y: (screen-y(Screen.games) - root.view-y) * self.height;
        games: UiState.installed-games;
        launch(index) => { UiState.games-launch(index); }
        back => { UiState.games-back(); }
    }

    if UiState.screen == Screen.game || root.previous-screen == Screen.game: GameScreen {
        width: 100%; height: 100%;
        x: (screen-x(Screen.game) - root.view-x) * self.width;
        y: (screen-y(Screen.game) - root.view-y) * self.height;
        commands: UiState.game-draw;
        positions: UiState.game-positions;
        error: UiState.game-error;
        active: UiState.screen == Screen.game;
        tick => { UiState.game-tick(); }
        event(kind, x, y) => { UiState.game-event(kind, x, y); }
        back => { UiState.game-back(); }
    }

    if UiState.screen == Screen.imu-calibration || root.previous-screen == Screen.imu-calibration: ImuCalibrationScreen {
        navigation-active: UiState.screen == Screen.imu-calibration;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.imu-calibration) - root.view-x) * self.width;
        y: (screen-y(Screen.imu-calibration) - root.view-y) * self.height;
        accel-x: UiState.imu-calibration-accel-x;
        accel-y: UiState.imu-calibration-accel-y;
        accel-z: UiState.imu-calibration-accel-z;
        gyro-x: UiState.imu-calibration-gyro-x;
        gyro-y: UiState.imu-calibration-gyro-y;
        gyro-z: UiState.imu-calibration-gyro-z;
        accel-text: UiState.imu-calibration-accel-text;
        gyro-text: UiState.imu-calibration-gyro-text;
        event-text: UiState.imu-calibration-event-text;
        imu-enabled: UiState.imu-calibration-enabled;
        imu-invert-x: UiState.imu-calibration-invert-x;
        imu-invert-y: UiState.imu-calibration-invert-y;
        imu-swap-xy: UiState.imu-calibration-swap-xy;
        step-text: UiState.imu-calibration-step-text;
        primary-button-text: UiState.imu-calibration-primary-button-text;
        show-axis-controls: UiState.imu-calibration-show-axis-controls;
        calibrate-level => { UiState.imu-calibration-calibrate-level(); }
        toggle-invert-x => { UiState.imu-calibration-toggle-invert-x(); }
        toggle-invert-y => { UiState.imu-calibration-toggle-invert-y(); }
        toggle-swap-xy => { UiState.imu-calibration-toggle-swap-xy(); }
        primary => { UiState.imu-calibration-primary(); }
        back => { UiState.imu-calibration-back(); }
    }

    if UiState.screen == Screen.update || root.previous-screen == Screen.update: UpdateScreen {
        navigation-active: UiState.screen == Screen.update;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.update) - root.view-x) * self.width;
        y: (screen-y(Screen.update) - root.view-y) * self.height;
        body-text: UiState.update-body;
        show-dropdown: UiState.update-show-dropdown;
        updates: UiState.updates;
        primary-text: UiState.update-primary-text;
        primary-enabled: UiState.update-primary-enabled;
        primary => { UiState.update-primary(); }
        secondary => { UiState.update-secondary(); }
        update-selected(i) => { UiState.update-selected(i); }
    }

    if UiState.screen == Screen.wifi || root.previous-screen == Screen.wifi: WifiScreen {
        navigation-active: UiState.screen == Screen.wifi;
        width: 100%; height: 100%;
        x: (screen-x(Screen.wifi) - root.view-x) * self.width;
        y: (screen-y(Screen.wifi) - root.view-y) * self.height;
        networks: UiState.wifi-networks;
        status: UiState.wifi-status;
        saved: UiState.wifi-saved;
        busy: UiState.wifi-busy;
        editing: UiState.wifi-editing;
        keys: UiState.wifi-keys;
        value: UiState.wifi-value;
        masked-value: UiState.wifi-masked-value;
        heading: UiState.wifi-heading;
        mode-label: UiState.wifi-mode-label;
        secret: UiState.wifi-secret;
        revealed <=> UiState.wifi-revealed;
        back => { UiState.wifi-back(); }
        scan => { UiState.wifi-scan(); }
        select(index) => { UiState.wifi-select(index); }
        connect-saved => { UiState.wifi-connect-saved(); }
        forget => { UiState.wifi-forget(); }
        manual => { UiState.wifi-manual(); }
        key(index) => { UiState.wifi-key(index); }
        mode => { UiState.wifi-mode(); }
        done => { UiState.wifi-done(); }
        cancel => { UiState.wifi-cancel(); }
    }

    if UiState.screen == Screen.charge || root.previous-screen == Screen.charge: ChargeScreen {
        active: UiState.screen == Screen.charge;
        width: 100%;
        height: 100%;
        x: (screen-x(Screen.charge) - root.view-x) * self.width;
        y: (screen-y(Screen.charge) - root.view-y) * self.height;
        battery-percent: UiState.charge-percent;
        charge-label: UiState.charge-label;
        time-estimate: UiState.charge-time-estimate;
        dismissed => { UiState.charge-tapped(); }
    }

    if UiState.show-fps && UiState.screen != Screen.display-test: FpsOverlay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        fps: UiState.fps;
        prepare-ms: UiState.perf-prepare-ms;
        render-ms: UiState.perf-render-ms;
        flush-ms: UiState.perf-flush-ms;
        dirty-pct: UiState.perf-dirty-pct;
    }

    if UiState.show-confirm-dialog && UiState.boot-notice == "" && !UiState.calibration-prompt && UiState.operation-error == "": ConfirmDialog {
        title: UiState.confirm-dialog-title;
        message: UiState.confirm-dialog-message;
        confirm-text: UiState.confirm-dialog-confirm-text;
        cancel-text: UiState.confirm-dialog-cancel-text;
        confirm-variant: UiState.confirm-dialog-variant;
        cancel-variant: UiState.confirm-dialog-cancel-variant;
        cancel-button-color: UiState.confirm-dialog-cancel-button-color;
        confirm-button-variant: UiState.confirm-dialog-confirm-button-variant;
        show-cancel: UiState.confirm-dialog-show-cancel;

        confirmed => { UiState.confirm-dialog-accepted(); }
        cancelled => { UiState.confirm-dialog-rejected(); }
    }

    // Crash-recovery notice: purely UI-driven, dismiss clears the property
    if UiState.boot-notice != "" && UiState.operation-error == "": ConfirmDialog {
        title: "Recovered from crash";
        message: UiState.boot-notice;
        confirm-text: "OK";
        show-cancel: false;
        confirmed => { UiState.boot-notice = ""; }
    }

    // Shown each boot until calibrated
    if UiState.calibration-prompt && UiState.boot-notice == "" && UiState.operation-error == "": ConfirmDialog {
        title: "Welcome to Pubmote";
        message: "Set up your remote, starting with joystick calibration, then review your settings in the menu.";
        confirm-text: "Get started";
        cancel-text: "Later";
        confirmed => {
            UiState.calibration-prompt = false;
            UiState.screen = Screen.input-calibration;
        }
        cancelled => { UiState.calibration-prompt = false; }
    }
    if UiState.operation-error != "": ConfirmDialog {
        title: "Could not finish";
        message: UiState.operation-error;
        confirm-text: "OK";
        show-cancel: false;
        confirmed => { UiState.operation-error = ""; }
    }

    if UiState.processing: ProcessingOverlay {
        width: 100%; height: 100%;
        message: UiState.processing-message;
    }
    }
}
