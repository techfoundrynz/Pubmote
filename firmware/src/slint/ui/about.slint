// AboutScreen — faithful reproduction of ui_AboutScreen.
//
// LVGL: ui_AboutContent (column SPACE_BETWEEN)
//   ui_AboutHeader (20%)  (empty row)
//   ui_AboutBody   (55%, horizontal-scroll row of two pages):
//       ui_VersionInfoContainer -> ui_VersionInfoLabel
//             "Version: unknown\nType: unknown\nHash: unknown"
//             ui_UpdateButton (outlined) "Check for updates"
//       ui_DebugInfoContainer, now a scrolling list of labelled diagnostics
//   ui_AboutFooter (25%) -> ui_AboutMainActionButton 80x42 "Back"

import { Theme } from "theme.slint";
import { AppButton } from "app-button.slint";
import { PagedPage } from "paged-page.slint";
import { GestureArea } from "gesture-area.slint";

// One line of the diagnostics page. A header carries only a label and titles the group
// below it; everything else is a label on the left and its value on the right.
export struct StatEntry {
    label: string,
    value: string,
    is-header: bool,
}

component StatRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px * Theme.scale;

    Text {
        text: root.label;
        color: Theme.text-dim;
        font-size: Theme.font-12;
        overflow: elide;
    }

    Text {
        text: root.value;
        color: Theme.text;
        font-family: Theme.font-mono;
        font-size: Theme.font-12;
        horizontal-alignment: right;
        horizontal-stretch: 1;
    }
}

export component AboutScreen inherits PagedPage {
    in property <string> version-info: "Version: unknown\nType: unknown\nHash: unknown";
    in property <[StatEntry]> stats: [];
    callback check-updates;
    callback secret;

    property <int> version-taps: 0;

    function count-version-tap() {
        root.version-taps += 1;
        tap-window.running = false;
        if (root.version-taps >= 5) {
            root.version-taps = 0;
            root.secret();
        } else {
            tap-window.running = true;
        }
    }

    title: "ABOUT";
    show-back: true;
    total-pages: 2;

    // Page 1: version + update button
    Rectangle {
        width: root.width;
        background: Theme.bg;
        VerticalLayout {
            padding-left: Theme.page-padding-horizontal;
            padding-right: Theme.page-padding-horizontal;
            spacing: 10px * Theme.scale;
            alignment: center;
            Rectangle {
                Text {
                    width: 100%;
                    text: root.version-info;
                    color: Theme.text;
                    font-size: Theme.font-14;
                    horizontal-alignment: center;
                    wrap: char-wrap;
                }

                // Sits on the Pager's swipe detector, so it forwards the drag itself
                GestureArea {
                    width: 100%;
                    height: 100%;
                    h-drag(d) => { root.set-drag(d); }
                    h-drag-end(d) => {
                        root.version-taps = 0;
                        root.end-drag();
                    }
                    drag-cancelled => { root.cancel-drag(); }
                    tapped => { root.count-version-tap(); }
                }

                tap-window := Timer {
                    interval: 1200ms;
                    running: false;
                    triggered => {
                        self.running = false;
                        root.version-taps = 0;
                    }
                }
            }

            AppButton {
                variant: "outline";
                text: "Check for updates";
                clicked => { root.check-updates(); }
            }
        }
    }
    // Page 2: battery and memory. Scrolls vertically - the section list grows past
    // the viewport on the shorter panels. The Flickable would grab horizontal
    // drags before the Pager saw them, so gestures are arbitrated by hand:
    // the dominant axis decides between scrolling the list and dragging the page.
    Rectangle {
        width: root.width;
        background: Theme.bg;
        flick2 := Flickable {
            interactive: false;
            content-height: debug-layout.min-height;
            debug-layout := VerticalLayout {
                padding-left: Theme.page-padding-horizontal;
                padding-right: Theme.page-padding-horizontal;
                padding-top: Theme.seam-size;
                padding-bottom: Theme.scroll-padding-bottom;
                spacing: 2px * Theme.scale;

                for entry in root.stats: VerticalLayout {
                    // A header gets breathing room above it, but not before the first
                    padding-top: entry.is-header ? 8px * Theme.scale : 0;

                    if entry.is-header: Text {
                        text: entry.label;
                        color: Theme.text;
                        font-size: Theme.font-11;
                        letter-spacing: 1px;
                    }

                    if !entry.is-header: StatRow {
                        label: entry.label;
                        value: entry.value;
                    }
                }
            }
        }

        GestureArea {
            width: 100%;
            height: 100%;
            property <bool> scrolling: false;
            property <length> start-vy;
            h-drag(d) => { root.set-drag(d); }
            h-drag-end(d) => { root.end-drag(); }
            v-drag(d) => {
                if (!self.scrolling) {
                    self.scrolling = true;
                    self.start-vy = flick2.content-y;
                }
                flick2.content-y = Math.max(Math.min(0px, flick2.height - debug-layout.min-height),
                    Math.min(0px, self.start-vy + d));
            }
            v-drag-end(d) => { self.scrolling = false; }
            drag-cancelled => {
                self.scrolling = false;
                root.cancel-drag();
            }
        }
    }
}
