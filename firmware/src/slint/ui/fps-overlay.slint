import { Theme } from "theme.slint";

export component FpsOverlay inherits Rectangle {
    in property <int> fps: 0;

    background: rgba(0, 0, 0, 0.6);
    border-radius: 12px;
    width: fps-layout.preferred-width;
    height: fps-layout.preferred-height;
    z: 9999;

    fps-layout := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        
        Text {
            text: root.fps + " FPS";
            color: #FFFFFF;
            // Theme token, not a raw px: only the scaled Theme sizes are embedded as
            // glyphs, so a hardcoded 24px renders from a scaled fallback.
            font-size: Theme.font-14;
            font-weight: Theme.w-medium;
            font-family: "JetBrains Mono";
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
