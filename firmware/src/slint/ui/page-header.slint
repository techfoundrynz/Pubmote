import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { NavigationFocus } from "navigation-focus.slint";

export component PageHeader inherits Rectangle {
    in property <string> text;
    in property <string> subtitle: "";
    in property <bool> subtitle-show-tail: false;
    in property <brush> text-color: Theme.accent;
    in property <bool> show-back: false;
    in property <bool> first-in-group: false;
    in property <bool> last-in-group: false;
    callback back;
    forward-focus: nav;
    // Sized by content (e.g. a subtitle), never below the standard strip
    height: Math.max(Theme.header-height, content.min-height);
    background: nav.has-focus ? Theme.focus-fill : Theme.bg;
    nav := NavigationFocus {
        width: 100%; height: 100%;
        available: root.show-back;
        first-in-group: root.first-in-group;
        last-in-group: root.last-in-group;
        activated => { root.back(); }
    }

    // Keeps content clear of the curved top edge on round panels
    property <length> top-inset: (Theme.is-square-mode ? 0px : 8px) * Theme.scale;

    content := VerticalLayout {
        alignment: center;
        spacing: 0;
        padding-top: root.top-inset;
        padding-bottom: 4px * Theme.scale;

        title-text := Text {
            text: root.text;
            color: nav.has-focus ? Theme.focus-color : root.text-color;
            font-size: Theme.font-14;
            font-weight: Theme.w-semibold;
            horizontal-alignment: center;
        }

        if root.subtitle != "": HorizontalLayout {
            padding-left: Theme.page-padding-horizontal;
            padding-right: Theme.page-padding-horizontal;
            Rectangle {
                min-width: 0px;
                height: subtitle-text.preferred-height;
                clip: true;
                subtitle-text := Text {
                    text: root.subtitle;
                    width: root.subtitle-show-tail ? Math.max(parent.width, self.preferred-width) : parent.width;
                    x: root.subtitle-show-tail ? parent.width - self.width : 0px;
                    overflow: elide;
                    color: nav.has-focus ? Theme.text : Theme.text-dim;
                    font-size: Theme.font-12;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Same gutter treatment as PageFooter: wider on round panels so the
    // chevron stays inside the circle at header height
    if root.show-back: Text {
        x: Theme.is-square-mode ? Theme.page-padding-horizontal : Theme.page-padding-horizontal * 1.5;
        y: title-text.y;
        height: title-text.height;
        text: Icons.chevron-left;
        font-family: Icons.font-family;
        color: nav.has-focus ? Theme.focus-color : root.text-color;
        font-size: Theme.font-14;
        vertical-alignment: center;
    }

    if root.show-back: TouchArea {
        clicked => { root.back(); }
    }
}
