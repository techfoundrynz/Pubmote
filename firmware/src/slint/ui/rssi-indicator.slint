import { Theme } from "theme.slint";

// Custom RSSI indicator without image dependencies (dot + arc segments).
export component RssiIndicator inherits Rectangle {
    in property <int> rssi: -100;
    // While searching (connecting/reconnecting) the stale rssi value is
    // meaningless - animate the segments 0->1->2->3 instead
    in property <bool> searching: false;
    in property <length> icon-size: 14px * Theme.scale;

    property <float> s: root.icon-size / 14px;
    property <int> rssi-bars: (root.rssi >= 0 || root.rssi <= -100) ? 0 : root.rssi > -75 ? 3 : root.rssi > -85 ? 2 : 1;
    property <int> cycle: 0;
    property <int> shown-bars: root.searching ? root.cycle : root.rssi-bars;

    // Alternate an invisible background so every tick dirties the whole icon
    // as one rect: per-segment dirty rects produce narrow flush chunks that
    // the partial-render pipeline garbles (segments lighting in the wrong places)
    background: root.searching && Math.mod(root.cycle, 2) == 0 ? #00000001 : transparent;

    Timer {
        interval: 350ms;
        running: root.searching;
        triggered => { root.cycle = Math.mod(root.cycle + 1, 4); }
    }

    width: 14px * root.s;
    height: 14px * root.s;

    // Dot at the bottom center
    Rectangle {
        x: 5.5px * root.s;
        y: 11px * root.s;
        width: 3px * root.s;
        height: 3px * root.s;
        border-radius: 1.5px * root.s;
        background: root.shown-bars >= 1 ? Theme.text : Theme.track;
    }

    // First arc (middle)
    ArcSegment {
        x: 1px * root.s;
        y: 6.5px * root.s;
        width: 12px * root.s;
        height: 12px * root.s;
        stroke: root.shown-bars >= 2 ? Theme.text : Theme.track;
        stroke-width: 2px * root.s;
        start-angle: 225deg;
        end-angle: 315deg;
        stroke-line-cap: LineCap.round;
    }

    // Second arc (top)
    ArcSegment {
        x: -3px * root.s;
        y: 2.5px * root.s;
        width: 20px * root.s;
        height: 20px * root.s;
        stroke: root.shown-bars >= 3 ? Theme.text : Theme.track;
        stroke-width: 2px * root.s;
        start-angle: 225deg;
        end-angle: 315deg;
        stroke-line-cap: LineCap.round;
    }
}
