import { Theme } from "theme.slint";
import { AppButton } from "app-button.slint";
import { PageFooter } from "page-footer.slint";

export struct PairedBoard {
    mac: string,
    index: int,
    is-active: bool,
    is-ble: bool,
}

export component BoardsScreen inherits Rectangle {
    in property <[PairedBoard]> boards: [];
    callback select-board(int);
    callback delete-board(int);
    callback pair-new;
    callback back;

    property <int> delete-mode-index: -1;

    background: Theme.bg;

    VerticalLayout {
        // Header (15% of screen height)
        Rectangle {
            vertical-stretch: 15;
            Text {
                text: "Paired Boards";
                color: Theme.text;
                font-size: Theme.font-14;
                font-weight: Theme.w-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // List body (60% of screen height)
        Rectangle {
            vertical-stretch: 60;

            if root.boards.length == 0: VerticalLayout {
                alignment: center;
                Text {
                    text: "No boards paired";
                    color: Theme.text-dim;
                    font-size: Theme.font-12;
                    horizontal-alignment: center;
                }
            }

            if root.boards.length > 0: Flickable {
                viewport-height: boards-layout.min-height;
                boards-layout := VerticalLayout {
                    // Padding must live on the layout (not the parent
                    // Rectangle) to actually constrain the rows on screen
                    padding-left: Theme.page-padding-horizontal;
                    padding-right: Theme.page-padding-horizontal;
                    spacing: 8px * Theme.scale;
                    alignment: start;

                    for board in root.boards: AppButton {
                        height: 38px * Theme.scale;
                        text: board.mac;
                        right-text: root.delete-mode-index == board.index ? "Delete"
                            : (board.is-ble ? "BLE" : "ESP-NOW") + (board.is-active ? " ✓" : "");
                        variant: root.delete-mode-index == board.index ? "outline" : (board.is-active ? "primary" : "secondary");
                        button-color: root.delete-mode-index == board.index ? "danger" : "standard";
                        clicked => {
                            if (root.delete-mode-index == board.index) {
                                root.delete-board(board.index);
                                root.delete-mode-index = -1;
                            } else {
                                root.delete-mode-index = -1;
                                root.select-board(board.index);
                            }
                        }
                        long-clicked => {
                            root.delete-mode-index = board.index;
                        }
                    }
                }
            }
        }

        // Footer (25% of screen height)
        PageFooter {
            vertical-stretch: 25;
            AppButton {
                text: "Back";
                variant: "secondary";
                clicked => { root.back(); }
            }

            AppButton {
                text: "Pair New";
                clicked => { root.pair-new(); }
            }
        }
    }
}
