import { Theme } from "theme.slint";
import { AppButton } from "app-button.slint";
import { PageFooter } from "page-footer.slint";
export component GamesScreen inherits Rectangle {
    in property <[string]> games;
    callback launch(int);
    callback back;
    background: Theme.bg;
    VerticalLayout {
        padding-top: Theme.page-padding-horizontal;
        Text { text: "ARCADE"; color: Theme.accent; font-size: Theme.font-14; horizontal-alignment: center; }
        Flickable {
            viewport-height: games-layout.min-height;
            games-layout := VerticalLayout {
                padding-left: Theme.page-padding-horizontal;
                padding-right: Theme.page-padding-horizontal;
                spacing: 8px * Theme.scale;
                if root.games.length == 0: Text {
                    text: "No games installed\nInstall games over USB";
                    color: Theme.text-dim; font-size: Theme.font-12;
                    horizontal-alignment: center; wrap: word-wrap;
                }
                for title[index] in root.games: AppButton {
                    text: title; variant: "secondary";
                    clicked => { root.launch(index); }
                }
            }
        }
        PageFooter { AppButton { text: "Back"; clicked => { root.back(); } } }
    }
}
