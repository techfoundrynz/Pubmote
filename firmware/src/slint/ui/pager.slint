import { Theme } from "theme.slint";

// Set by controls that drag horizontally, so a Pager leaves that touch to them
export global PagerGesture {
    in-out property <bool> claimed: false;
}

export component Pager inherits Rectangle {
    in-out property <int> current-page: 0;
    in property <int> total-pages: 2;
    init => { PagerGesture.claimed = false; }

    // Sees drags before the pages, so a page that scrolls can't swallow the swipe
    SwipeGestureHandler {
        width: 100%;
        height: 100%;
        enabled: !PagerGesture.claimed;
        handle-swipe-left: root.current-page < root.total-pages - 1;
        handle-swipe-right: root.current-page > 0;
        swiped => {
            let diff = self.current-position.x - self.pressed-position.x;
            if diff > 40px && root.current-page > 0 {
                root.current-page -= 1;
            } else if diff < -40px && root.current-page < root.total-pages - 1 {
                root.current-page += 1;
            }
        }

        VerticalLayout {
            // Page Indicators (Dots)
            Rectangle {
                height: round(30px / 1px * Theme.scale) * 1px;
                HorizontalLayout {
                    alignment: center;
                    spacing: round(4px / 1px * Theme.scale) * 1px;
                    padding-top: round(15px / 1px * Theme.scale) * 1px;
                    for i in root.total-pages: Rectangle {
                        width: round(6px / 1px * Theme.scale) * 1px;
                        height: round(6px / 1px * Theme.scale) * 1px;
                        border-radius: round(self.width / 1px / 2) * 1px;
                        background: i == root.current-page ? Theme.accent : Theme.track;
                    }
                }
            }

            // Pager body
            Rectangle {
                vertical-stretch: 1;
                clip: true;
            
                HorizontalLayout {
                    spacing: 0;
                    width: root.width * root.total-pages;
                    height: 100%;
                    x: -root.current-page * root.width;
                    animate x { duration: 250ms; easing: ease-out; }

                    @children
                }
            }
        }
    }
}
