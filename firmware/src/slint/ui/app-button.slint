import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

// Common touch button component with variant and size options.
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";    // Lucide glyph from Icons, shown left of the label
    in property <string> right-text: "";
    in property <string> variant: "primary"; // "primary", "secondary", "outline", "ghost"
    in property <string> button-color: "standard";  // "standard", "success", "danger"
    in property <bool> enabled: true;
    callback clicked;
    callback long-clicked;
    property <bool> was-long-pressed: false;

    pure function get-base-color() -> color {
        if (root.button-color == "success") { return Theme.color-success; }
        if (root.button-color == "danger") { return Theme.color-critical; }
        return Theme.accent;
    }

    height: 30px * Theme.scale;
    border-radius: 12px * Theme.scale;
    
    // Always have a 2px border to prevent layout shifts on focus
    border-width: 2px;
    border-color: f-scope.has-focus ? #ffffff : (root.variant == "outline" ? Theme.text : transparent);

    // Background color based on variant and state
    background: !root.enabled ? Theme.track :
        root.variant == "outline" ? (touch.pressed ? #ffffff20 : transparent) :
        root.variant == "secondary" ? (touch.pressed ? Theme.track.darker(0.2) : Theme.track) :
        // No desaturate() in this Slint version; mixing toward the gray track desaturates
        root.variant == "ghost" ? root.get-base-color().mix(Theme.track, 0.8).mix(Theme.bg, touch.pressed ? 0.4 : 0.2) :
        // default/primary
        (touch.pressed ? root.get-base-color().darker(0.2) : root.get-base-color());

    f-scope := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px * Theme.scale;
        padding-right: 12px * Theme.scale;
        alignment: (root.variant == "ghost" || root.right-text != "") ? LayoutAlignment.space-between : LayoutAlignment.center;

        HorizontalLayout {
            spacing: 8px * Theme.scale;

            if root.icon != "": Text {
                text: root.icon;
                font-family: Icons.font-family;
                color: !root.enabled ? Theme.text-dim : Theme.accent;
                font-size: Theme.font-14;
                vertical-alignment: center;
            }

            Text {
                text: root.text;
                color: !root.enabled ? Theme.text-dim :
                    root.variant == "outline" ? Theme.text :
                    root.variant == "secondary" ? Theme.text :
                    root.variant == "ghost" ? Theme.text :
                    // default/primary
                    Theme.primary-button-text;
                font-size: Theme.font-12;
                font-weight: Theme.w-semibold;
                vertical-alignment: center;
            }
        }

        if root.right-text != "" : Text {
            text: root.right-text;
            color: !root.enabled ? Theme.text-dim :
                root.variant == "ghost" ? Theme.text-dim :
                root.variant == "outline" ? Theme.text-dim :
                root.variant == "secondary" ? Theme.text-dim :
                Theme.primary-button-text.transparentize(0.3);
            font-size: Theme.font-11;
            font-weight: Theme.w-medium;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (!root.was-long-pressed) {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    root.was-long-pressed = false;
                    long-press-timer.running = true;
                } else if (event.kind == PointerEventKind.up) {
                    long-press-timer.running = false;
                }
            }
        }
    }

    long-press-timer := Timer {
        interval: 800ms;
        running: false;
        triggered => {
            self.running = false;
            root.was-long-pressed = true;
            root.long-clicked();
        }
    }
}
