import { Theme } from "theme.slint";
import { NavigationFocus } from "navigation-focus.slint";

export component AppSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> first-in-group: false;
    callback toggled;
    nav := NavigationFocus {
        width: 100%; height: 100%;
        first-in-group: root.first-in-group;
        activated => { root.checked = !root.checked; root.toggled(); }
    }
    
    height: round(36px / 1px * Theme.scale) * 1px;
    width: round(64px / 1px * Theme.scale) * 1px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : nav.has-focus ? Theme.edit-fill : Theme.track;
    
    animate background { duration: 150ms; }
    
    thumb := Rectangle {
        width: root.height - round(8px / 1px * Theme.scale) * 1px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.text;
        border-width: 2px * Theme.scale;
        border-color: nav.has-focus ? Theme.focus-color : transparent;
        
        x: root.checked ? root.width - self.width - round(4px / 1px * Theme.scale) * 1px : round(4px / 1px * Theme.scale) * 1px;
        y: round((root.height - self.height) / 1px / 2) * 1px;
        
        animate x { duration: 150ms; easing: ease-out; }
    }
    
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}
