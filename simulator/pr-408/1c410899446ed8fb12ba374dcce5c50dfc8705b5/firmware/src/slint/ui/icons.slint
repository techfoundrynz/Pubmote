// Glyphs from firmware/assets/lucide-icons.ttf, a subset of the Lucide icon
// font (lucide-static npm package). The full font is ~1500 icons and Slint
// pre-rasterizes every embedded glyph, so only the icons named here are kept.
// To add one: look up its codepoint in lucide.css, re-subset with
//   python -m fontTools.subset lucide.ttf --unicodes=U+E06E,... --no-layout-closure
// and add a property below.
export global Icons {
    out property <string> font-family: "lucide";
    out property <string> bluetooth: "\u{e05c}";
    out property <string> chevron-left: "\u{e06e}";
    out property <string> chevron-right: "\u{e06f}";
    out property <string> info: "\u{e0f9}";
    out property <string> link: "\u{e102}";
    out property <string> lock: "\u{e10b}";
    out property <string> power: "\u{e140}";
    out property <string> radio: "\u{e142}";
    out property <string> settings: "\u{e154}";
    out property <string> sun: "\u{e178}";
    out property <string> lightbulb: "\u{e1c2}";
    out property <string> axis-3d: "\u{e2fe}";
    out property <string> joystick: "\u{e355}";
}
