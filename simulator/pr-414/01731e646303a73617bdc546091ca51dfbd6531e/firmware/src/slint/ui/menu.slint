// MenuScreen — faithful reproduction of ui_MenuScreen.
//
// LVGL: ui_MenuContent (column SPACE_BETWEEN) -> ui_MenuBody (scrollable column,
// pad 40, row gap 10) with buttons in this exact order:
//   Back, Connect (hidden), Enable Pocket Mode, Settings, Calibration, Pairing,
//   About, Shutdown. Each lv_btn is 42px tall, 100% width.

import { Theme } from "theme.slint";
import { MenuButton } from "menu-button.slint";
import { Page } from "page.slint";
import { Icons } from "icons.slint";

export component MenuScreen inherits Page {
    // Stable item IDs preserve selection even when optional rows disappear.
    in-out property <int> focus-index: -1;
    initial-focus-steps: root.focus-index < 0 ? 1 :
        root.focus-index - (root.focus-index >= 1 && !root.show-connect ? 1 : 0)
        - (root.focus-index >= 3 && !root.dimming-mode-supported ? 1 : 0)
        - (root.focus-index >= 4 && !root.led-mode-supported ? 1 : 0)
        - (root.focus-index >= 6 && !root.joystick-supported ? 1 : 0)
        - (root.focus-index >= 7 && !root.imu-supported ? 1 : 0);
    header-focused => { root.focus-index = 0; }
    in property <bool> show-connect: false;       // ui_MenuConnectButton (hidden)
    in property <string> connect-label: "Connect";
    in property <bool> pocket-mode-active: false;
    // Labels rather than indices - ui_dimming_mode_label() in ui/device_preferences.cpp and
    // led_mode_label() in led.c own the names, so the enum ordering is not
    // duplicated here where it could silently drift.
    in property <string> dimming-mode-label: "";
    in property <bool> dimming-mode-supported: false;
    in property <string> led-mode-label: "";
    in property <bool> led-mode-supported: false;
    in-out property <int> scroll-offset-y: 0;
    changed scroll-offset-y => {
        // Also reset a retained menu while its exit animation is running.
        if (root.scroll-offset-y == 0) { flick.content-y = 0px; }
    }
    in property <bool> imu-supported: false;
    in property <bool> joystick-supported: false;
    callback connect;
    callback pocket-mode;
    callback toggle-dimming;
    callback toggle-led;
    callback settings;
    callback calibration;
    callback pairing;
    callback about;
    callback wifi;
    callback imu-calibration;
    callback shutdown;

    title: "MENU";
    show-back: true;

    flick := Flickable {
        content-height: menu-layout.min-height;
        init => {
            self.content-y = -root.scroll-offset-y * 1px;
        }
        changed content-y => {
            root.scroll-offset-y = -self.content-y / 1px;
        }
        menu-layout := VerticalLayout {
            padding-top: Theme.seam-size;
            padding-left: Theme.page-padding-horizontal;
            padding-right: Theme.page-padding-horizontal;
            padding-bottom: Theme.scroll-padding-bottom;
            spacing: 6px * Theme.scale;

            if root.show-connect: MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 1; } }
                text: root.connect-label;
                first-in-group: !root.show-back;
                icon: Icons.radio;
                right-text: "";
                clicked => { root.connect(); }
            }

            MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 2; } }
                text: "Pocket mode";
                first-in-group: !root.show-back && !root.show-connect;
                icon: Icons.lock;
                right-text: root.pocket-mode-active ? "On" : "Off";
                clicked => { root.pocket-mode(); }
            }

            if root.dimming-mode-supported: MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 3; } }
                text: "Dimming";
                icon: Icons.sun;
                right-text: root.dimming-mode-label;
                clicked => { root.toggle-dimming(); }
            }

            if root.led-mode-supported: MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 4; } }
                text: "LED mode";
                icon: Icons.lightbulb;
                right-text: root.led-mode-label;
                clicked => { root.toggle-led(); }
            }

            MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 5; } }
                text: "Settings";
                icon: Icons.settings;
                right-text: "\u{203a}";
                clicked => { root.settings(); }
            }

            if root.joystick-supported: MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 6; } }
                text: "Inputs";
                icon: Icons.joystick;
                right-text: "\u{203a}";
                clicked => { root.calibration(); }
            }

            if root.imu-supported: MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 7; } }
                text: "IMU";
                icon: Icons.axis-3d;
                right-text: "\u{203a}";
                clicked => { root.imu-calibration(); }
            }

            MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 8; } }
                text: "Pairing";
                icon: Icons.bluetooth;
                right-text: "\u{203a}";
                clicked => { root.pairing(); }
            }

            MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 9; } }
                text: "Wi-Fi";
                icon: Icons.radio;
                right-text: "\u{203a}";
                clicked => { root.wifi(); }
            }

            MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 10; } }
                text: "About";
                icon: Icons.info;
                right-text: "\u{203a}";
                clicked => { root.about(); }
            }

            MenuButton {
                changed has-focus => { if (self.has-focus) { root.focus-index = 11; } }
                text: "Shutdown";
                last-in-group: true;
                icon: Icons.power;
                right-text: "";
                clicked => { root.shutdown(); }
            }
        }
    }
}
