import { Slider, CheckBox, ComboBox } from "std-widgets.slint";
export component SimulatorControls inherits Window {
    title: "PubRemote — simulated hardware";
    width: 420px;
    height: 620px;
    in-out property <float> speed: 18;
    in-out property <float> battery: 82;
    in-out property <float> remote-battery: 95;
    in-out property <float> rssi: -55;
    in-out property <float> joystick-x: 0;
    in-out property <float> joystick-y: 0;
    in-out property <bool> connected: true;
    in-out property <bool> charging: false;
    in-out property <bool> left-pad: true;
    in-out property <bool> right-pad: true;
    in-out property <bool> animate: true;
    callback navigate(string);
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text { text: "Real Slint screens • simulated device services"; }
        ComboBox {
            model: ["stats", "menu", "settings", "boards", "pairing", "wifi", "input-calibration", "imu-calibration", "about", "update", "charge", "games"];
            selected(value) => { root.navigate(value); }
        }
        HorizontalLayout {
            CheckBox { text: "Connected"; checked <=> root.connected; }
            CheckBox { text: "Animate ride"; checked <=> root.animate; }
        }
        Text { text: "Speed: " + round(root.speed) + " km/h"; }
        Slider { minimum: 0; maximum: 60; value <=> root.speed; }
        Text { text: "Board battery: " + round(root.battery) + "%"; }
        Slider { minimum: 0; maximum: 100; value <=> root.battery; }
        Text { text: "Remote battery: " + round(root.remote-battery) + "%"; }
        Slider { minimum: 0; maximum: 100; value <=> root.remote-battery; }
        Text { text: "RSSI: " + round(root.rssi) + " dBm"; }
        Slider { minimum: -100; maximum: -20; value <=> root.rssi; }
        HorizontalLayout {
            CheckBox { text: "Left pad"; checked <=> root.left-pad; }
            CheckBox { text: "Right pad"; checked <=> root.right-pad; }
            CheckBox { text: "Charging"; checked <=> root.charging; }
        }
        Text { text: "Joystick X / Y (calibration input)"; }
        Slider { minimum: -1; maximum: 1; value <=> root.joystick-x; }
        Slider { minimum: -1; maximum: 1; value <=> root.joystick-y; }
        Text { text: "Click and drag the remote to use touch gestures.\nTab / Shift+Tab moves focus; Enter activates.\nSettings last until this simulator closes."; wrap: word-wrap; }
    }
}
