import { Theme } from "theme.slint";
import { Page } from "page.slint";

export struct DisplayTouchPoint { x: float, y: float }
export component DisplayTestScreen inherits Page {
    in property <bool> active: false;
    in property <bool> hardware-input: false;
    in property <[DisplayTouchPoint]> points;
    in property <string> coordinates: "Touch anywhere";
    title: "DISPLAY TEST";
    subtitle: root.hardware-input ? root.coordinates : root.has-touch ? "X " + root.last-x + "  Y " + root.last-y : "Touch anywhere";
    show-back: true;
    header-background: transparent;
    header-text-color: root.ink;
    header-subtitle-color: root.ink;
    show-header-fade: false;
    header-touch(x, y, pressed) => {
        root.pointer-down = pressed;
        root.record-touch(x, y);
    }
    back-is-only: true;
    navigation-active: root.active;
    property <int> color-index: 0;
    property <color> ink: root.color-index == 1 || root.color-index == 3 ? #000000 : #ffffff;
    property <float> last-x: 0;
    property <float> last-y: 0;
    property <bool> has-touch: false;
    property <bool> pointer-down: false;
    property <[DisplayTouchPoint]> active-points: root.hardware-input ? root.points : root.pointer-down ? [{x: root.last-x, y: root.last-y}] : [];
    background: root.color-index == 0 ? #ff0000 : root.color-index == 1 ? #00ff00 : root.color-index == 2 ? #0000ff : root.color-index == 3 ? #ffffff : #000000;
    clip: true;

    function record-touch(x: length, y: length) {
        root.last-x = Math.round(x / 1px);
        root.last-y = Math.round(y / 1px);
        root.has-touch = true;
    }
    Timer {
        interval: 5s; running: root.active;
        triggered => { root.color-index = Math.mod(root.color-index + 1, 5); }
    }
    body := Rectangle {
        vertical-stretch: 1;
        // Contacts use full-screen coordinates and may overlap the header.
        for point in root.active-points: Rectangle {
            x: point.x * 1px - self.width / 2; y: point.y * 1px - body.y - self.height / 2;
            width: 36px * Theme.scale; height: self.width;
            border-width: 2px * Theme.scale; border-color: root.ink; border-radius: self.width / 2;
        }
        TouchArea {
            width: 100%; height: 100%; enabled: root.active;
            moved => { if self.pressed { root.record-touch(self.mouse-x, self.mouse-y + body.y); } }
            pointer-event(event) => {
                if event.button == PointerEventButton.left {
                    if event.kind == PointerEventKind.down {
                        root.pointer-down = true;
                        root.record-touch(self.mouse-x, self.mouse-y + body.y);
                    } else if event.kind == PointerEventKind.up {
                        root.record-touch(self.mouse-x, self.mouse-y + body.y);
                        root.pointer-down = false;
                    } else if event.kind == PointerEventKind.cancel {
                        root.pointer-down = false;
                    }
                }
            }
        }
    }
}
