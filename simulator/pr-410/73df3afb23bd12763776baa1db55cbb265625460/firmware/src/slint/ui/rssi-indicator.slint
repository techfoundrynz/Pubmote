import { Theme } from "theme.slint";

// The 225deg..315deg cap of a signal arc, on stock Path/ArcTo.
component SignalArc inherits Rectangle {
    in property <brush> stroke-color;
    in property <length> thickness;

    property <length> r: (min(root.width, root.height) - root.thickness) / 2;
    // Path offsets the whole shape by half the stroke width to keep it inside the
    // element, so the centre has to be pulled back by the same amount
    property <length> cx: (root.width - root.thickness) / 2;
    property <length> cy: (root.height - root.thickness) / 2;

    Path {
        // A Path defaults to a zero size and is skipped entirely by the renderer.
        // fit: preserve keeps the coordinates below as literal pixels - the default
        // (contain) would rescale the arc's bounding box to fill the element.
        width: 100%;
        height: 100%;
        fit: preserve;
        arc-center-x: root.width / 2;
        arc-center-y: root.height / 2;
        arc-radius: root.r;
        arc-start-angle: 225deg;
        arc-sweep-angle: 90deg;
        stroke: root.stroke-color;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        MoveTo {
            x: (root.cx + root.r * Math.cos(225deg)) / 1px;
            y: (root.cy + root.r * Math.sin(225deg)) / 1px;
        }

        ArcTo {
            radius-x: root.r / 1px;
            radius-y: root.r / 1px;
            x: (root.cx + root.r * Math.cos(315deg)) / 1px;
            y: (root.cy + root.r * Math.sin(315deg)) / 1px;
            large-arc: false;
            sweep: true;
        }
    }
}

// Custom RSSI indicator without image dependencies (dot + arc segments).
export component RssiIndicator inherits Rectangle {
    in property <int> rssi: -100;
    // While searching (connecting/reconnecting) the stale rssi value is
    // meaningless - animate the segments 0->1->2->3 instead
    in property <bool> searching: false;
    in property <length> icon-size: 14px * Theme.scale;

    property <float> s: root.icon-size / 14px;
    property <int> rssi-bars: (root.rssi >= 0 || root.rssi <= -100) ? 0 : root.rssi > -75 ? 3 : root.rssi > -85 ? 2 : 1;
    property <int> cycle: 0;
    property <int> shown-bars: root.searching ? root.cycle : root.rssi-bars;

    // Alternate an invisible background so every tick dirties the whole icon
    // as one rect: per-segment dirty rects produce narrow flush chunks that
    // the partial-render pipeline garbles (segments lighting in the wrong places)
    background: root.searching && Math.mod(root.cycle, 2) == 0 ? #00000001 : transparent;

    Timer {
        interval: 350ms;
        running: root.searching;
        triggered => { root.cycle = Math.mod(root.cycle + 1, 4); }
    }

    width: 14px * root.s;
    height: 14px * root.s;

    // Dot at the bottom center
    Rectangle {
        x: 5.5px * root.s;
        y: 11px * root.s;
        width: 3px * root.s;
        height: 3px * root.s;
        border-radius: 1.5px * root.s;
        background: root.shown-bars >= 1 ? Theme.text : Theme.track;
    }

    // First arc (middle)
    SignalArc {
        x: 1px * root.s;
        y: 6.5px * root.s;
        width: 12px * root.s;
        height: 12px * root.s;
        stroke-color: root.shown-bars >= 2 ? Theme.text : Theme.track;
        thickness: 2px * root.s;
    }

    // Second arc (top)
    SignalArc {
        x: -3px * root.s;
        y: 2.5px * root.s;
        width: 20px * root.s;
        height: 20px * root.s;
        stroke-color: root.shown-bars >= 3 ? Theme.text : Theme.track;
        thickness: 2px * root.s;
    }
}
