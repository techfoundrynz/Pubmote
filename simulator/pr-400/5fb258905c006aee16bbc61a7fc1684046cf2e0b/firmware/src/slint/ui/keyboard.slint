import { Theme } from "theme.slint";
import { AppButton } from "app-button.slint";
import { Page } from "page.slint";

component KeyboardButton inherits AppButton {
    height: 100%;
    min-height: 24px * Theme.scale;
    preferred-height: 30px * Theme.scale;
    vertical-stretch: 1;
    horizontal-padding: 2px * Theme.scale;
    label-font-size: Theme.font-14;
    hold-duration: 600ms;
    strong-press-feedback: true;
    variant: "secondary";
}

// Reusable touch/focus keyboard. The caller supplies an instance-local editor.
export component Keyboard inherits Page {
    in property <[string]> keys;
    in property <string> value;
    in property <string> masked-value;
    in property <string> heading;
    in property <string> mode-label: "123";
    in property <bool> secret: false;
    in-out property <bool> revealed: false;
    callback key(int);
    callback mode;
    callback done;
    callback cancel;
    title: root.heading;
    // Reserve the subtitle line while empty so typing does not move the keys.
    subtitle: root.value == "" ? " " : root.secret && !root.revealed ? root.masked-value : root.value;
    subtitle-show-tail: true;
    show-back: true;
    back => { root.cancel(); }
    VerticalLayout {
        padding-top: 6px * Theme.scale;
        padding-bottom: (Theme.is-square-mode ? 10px : 24px) * Theme.scale;
        spacing: 4px * Theme.scale;
        for row in 4: HorizontalLayout {
            vertical-stretch: 1;
            padding-left: (Theme.is-square-mode ? 12px : (row == 3 ? 35px : 24px)) * Theme.scale;
            padding-right: (Theme.is-square-mode ? 12px : (row == 3 ? 35px : 24px)) * Theme.scale;
            spacing: 4px * Theme.scale;
            for col in 3: key-button := KeyboardButton {
                text: root.keys[row * 3 + col];
                clicked => { root.key(row * 3 + col); }
                long-clicked => { root.key(row * 3 + col); }
                Timer {
                    interval: 100ms;
                    running: row * 3 + col == 11 && key-button.hold-active;
                    triggered => { root.key(11); }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 4px * Theme.scale;
            padding-left: (Theme.is-square-mode ? 12px : 50px) * Theme.scale;
            padding-right: (Theme.is-square-mode ? 12px : 50px) * Theme.scale;
            KeyboardButton { text: root.mode-label; clicked => { root.mode(); } }
            if root.secret: KeyboardButton { text: root.revealed ? "Hide" : "Show"; clicked => { root.revealed = !root.revealed; } }
            KeyboardButton { text: "Done"; variant: "primary"; clicked => { root.done(); } }
        }
    }
}
