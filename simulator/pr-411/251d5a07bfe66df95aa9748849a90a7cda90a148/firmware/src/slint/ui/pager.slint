import { Theme } from "theme.slint";
import { GestureArea } from "gesture-area.slint";
import { NavigationFocus } from "navigation-focus.slint";

// Page indicator dots; lives in the page footer next to the Pager body
export component PagerDots inherits Rectangle {
    in-out property <int> current-page: 0;
    in property <int> total-pages: 2;
    in property <bool> first-in-group: false;
    in property <bool> last-in-group: false;
    property <length> dot: round(4px / 1px * Theme.scale) * 1px;
    height: 16px * Theme.scale;
    nav := NavigationFocus {
        width: 100%; height: 100%;
        available: root.total-pages > 1;
        adjustable: true;
        horizontal-adjusts: true;
        horizontal-adjustment: -1;
        first-in-group: root.first-in-group;
        last-in-group: root.last-in-group;
        adjusted(direction) => { root.current-page = clamp(root.current-page - direction, 0, root.total-pages - 1); }
    }

    Rectangle {
        width: root.total-pages * 8px * Theme.scale + 12px * Theme.scale;
        height: 100%;
        x: (root.width - self.width) / 2;
        border-radius: self.height / 2;
        background: nav.has-focus ? (nav.editing ? Theme.edit-fill : Theme.focus-fill) : transparent;
    }
    HorizontalLayout {
        alignment: center;
        spacing: round(2px / 1px * Theme.scale) * 1px;

        for i in root.total-pages: VerticalLayout {
            alignment: center;
            width: 6px * Theme.scale;
            Rectangle {
                width: i == root.current-page && nav.has-focus ? 6px * Theme.scale : root.dot;
                height: i == root.current-page && nav.editing ? 6px * Theme.scale : root.dot;
                border-radius: round(root.dot / 1px / 2) * 1px;
                background: i == root.current-page ? (nav.has-focus ? Theme.focus-color : Theme.accent) : Theme.track;
            }
        }
    }
}

export component Pager inherits Rectangle {
    in-out property <int> current-page: 0;
    in property <int> total-pages: 2;

    property <bool> dragging: false;
    property <length> drag-offset: 0px;
    // Scaled to the remaining distance on release so the snap keeps the
    // baseline velocity (one page per 250ms) instead of a fixed duration
    property <duration> snap-duration: 250ms;

    // A gesture moves at most one page and never drags past the ends. Pages
    // with their own swipe detector (About page 1) call these to stay in sync.
    public function set-drag(offset: length) {
        self.dragging = true;
        self.drag-offset = Math.max(self.current-page < self.total-pages - 1 ? -self.width : 0px,
            Math.min(self.current-page > 0 ? self.width : 0px, offset));
    }

    public function end-drag() {
        self.dragging = false;
        if (self.drag-offset > 40px && self.current-page > 0) {
            self.snap-duration = (1.0 - self.drag-offset / self.width) * 250ms;
            self.current-page -= 1;
        } else if (self.drag-offset < -40px && self.current-page < self.total-pages - 1) {
            self.snap-duration = (1.0 + self.drag-offset / self.width) * 250ms;
            self.current-page += 1;
        } else {
            self.snap-duration = Math.abs(self.drag-offset / self.width) * 250ms;
        }
        self.drag-offset = 0px;
    }

    // Another element grabbed the pointer mid-drag; snap back without committing
    public function cancel-drag() {
        self.dragging = false;
        self.snap-duration = Math.abs(self.drag-offset / self.width) * 250ms;
        self.drag-offset = 0px;
    }

    // Background swipe detector for page dragging/snapping
    GestureArea {
        width: 100%;
        height: 100%;
        h-drag(d) => { root.set-drag(d); }
        h-drag-end(d) => { root.end-drag(); }
        drag-cancelled => { root.cancel-drag(); }
    }

    // Pager body
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clip: true;

        HorizontalLayout {
            spacing: 0;
            width: root.width * root.total-pages;
            height: 100%;
            x: -root.current-page * root.width + root.drag-offset;
            animate x { duration: root.dragging ? 0ms : root.snap-duration; easing: ease-out; }

            @children
        }
    }
}
