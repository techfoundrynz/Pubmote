import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { NavigationFocus } from "navigation-focus.slint";

// Common touch button component with variant and size options.
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";    // Lucide glyph from Icons, shown left of the label
    in property <string> right-text: "";
    in property <string> variant: "primary"; // "primary", "secondary", "outline", "ghost"
    in property <string> button-color: "standard";  // "standard", "success", "danger"
    in property <bool> enabled: true;
    in property <bool> modal-control: false;
    in property <bool> first-in-group: false;
    in property <bool> last-in-group: false;
    in property <bool> initial-focus: false;
    in property <bool> directional-navigation: false;
    callback navigated(int, int);
    property <bool> focus-pending: root.initial-focus;
    // Conditional overlays become eligible after their creation. Retry once
    // per UI tick until focus succeeds, then leave focus to the user.
    Timer {
        interval: 20ms;
        running: root.focus-pending;
        triggered => {
            if (!f-scope.accepts-input) { return; }
            f-scope.focus();
            if (f-scope.has-focus) { root.focus-pending = false; }
        }
    }
    out property <bool> has-focus: f-scope.has-focus;
    out property <bool> navigation-enabled: f-scope.accepts-input;
    forward-focus: f-scope;
    in property <length> label-font-size: Theme.font-12;
    in property <length> horizontal-padding: 12px * Theme.scale;
    in property <duration> hold-duration: 800ms;
    in property <bool> strong-press-feedback: false;
    out property <bool> hold-active: touch.pressed && root.was-long-pressed;
    callback clicked;
    callback long-clicked;
    property <bool> was-long-pressed: false;

    pure function get-base-color() -> color {
        if (root.button-color == "success") { return Theme.color-success; }
        if (root.button-color == "danger") { return Theme.color-critical; }
        return Theme.accent;
    }

    height: 34px * Theme.scale;
    border-radius: root.height / 3;

    // Always have a 2px border to prevent layout shifts on focus
    border-width: 2px;
    border-color: root.variant == "outline" ? (f-scope.has-focus ? Theme.accent : Theme.text) :
        root.strong-press-feedback && touch.pressed ? Theme.focus-color : transparent;

    // Background color based on variant and state
    background: !root.enabled ? Theme.track :
        root.strong-press-feedback && touch.pressed ? root.get-base-color().mix(Theme.text, 0.2) :
        f-scope.has-focus ? (root.variant == "primary" ? root.get-base-color().mix(Theme.bg, 0.88) : Theme.focus-fill) :
        root.variant == "outline" ? (touch.pressed ? #ffffff20 : transparent) :
        root.variant == "secondary" ? (touch.pressed ? Theme.track.darker(0.2) : Theme.track) :
        // No desaturate() in this Slint version; mixing toward the gray track desaturates
        root.variant == "ghost" ? root.get-base-color().mix(Theme.track, 0.8).mix(Theme.bg, touch.pressed ? 0.4 : 0.2) :
        // default/primary
        (touch.pressed ? root.get-base-color().darker(0.2) : root.get-base-color());

    f-scope := NavigationFocus {
        width: 100%;
        height: 100%;
        available: root.enabled;
        modal-control: root.modal-control;
        first-in-group: root.first-in-group;
        last-in-group: root.last-in-group;
        directional-navigation: root.directional-navigation;
        navigated(x, y) => { root.navigated(x, y); }
        activated => { root.clicked(); }
    }
    Rectangle {
        x: 4px * Theme.scale;
        y: (root.height - self.height) / 2;
        width: 3px * Theme.scale;
        height: root.height * 0.45;
        border-radius: self.width / 2;
        background: !f-scope.has-focus || root.variant == "outline" ? transparent :
            root.variant == "primary" ? Theme.primary-button-text : Theme.focus-color;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.horizontal-padding;
        padding-right: root.horizontal-padding;
        alignment: (root.variant == "ghost" || root.right-text != "") ? LayoutAlignment.space-between : LayoutAlignment.center;

        HorizontalLayout {
            min-width: 0px;
            spacing: 8px * Theme.scale;

            if root.icon != "": Text {
                text: root.icon;
                font-family: Icons.font-family;
                color: !root.enabled ? Theme.text-dim : Theme.accent;
                font-size: Theme.font-14;
                vertical-alignment: center;
            }

            Text {
                text: root.text;
                min-width: 0px;
                overflow: elide;
                color: !root.enabled ? Theme.text-dim :
                    root.strong-press-feedback && touch.pressed ? Theme.primary-button-text :
                    root.variant == "outline" ? Theme.text :
                    root.variant == "secondary" ? Theme.text :
                    root.variant == "ghost" ? Theme.text :
                    // default/primary
                    Theme.primary-button-text;
                font-size: root.label-font-size;
                font-weight: Theme.w-semibold;
                vertical-alignment: center;
            }
        }

        if root.right-text != "": Text {
            text: root.right-text;
            color: !root.enabled ? Theme.text-dim :
                root.variant == "ghost" ? Theme.text-dim :
                root.variant == "outline" ? Theme.text-dim :
                root.variant == "secondary" ? Theme.text-dim :
                Theme.primary-button-text.transparentize(0.3);
            font-size: Theme.font-11;
            font-weight: Theme.w-medium;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (!root.was-long-pressed) {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    root.was-long-pressed = false;
                    long-press-timer.running = true;
                } else if (event.kind == PointerEventKind.up) {
                    long-press-timer.running = false;
                }
            }
        }
    }

    long-press-timer := Timer {
        interval: root.hold-duration;
        running: false;
        triggered => {
            self.running = false;
            if (!touch.pressed) { return; }
            root.was-long-pressed = true;
            root.long-clicked();
        }
    }
}
