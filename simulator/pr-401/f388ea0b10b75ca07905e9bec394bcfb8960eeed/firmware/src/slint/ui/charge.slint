// ChargeScreen — faithful reproduction of ui_ChargeScreen.
//
// LVGL: ui_ChargeLevelDial  lv_arc 240x240 centered, full circle (bg 90..89),
//                           value 0; white knob (hidden).
//       ui_ChargeInfoContainer (centered column):
//         ui_ChargeInfoPrimaryLabel "Charging" Inter_Bold_14
//         ui_ChargeInfoLevelLabel   "0%"       Inter_14

import { Theme } from "theme.slint";
import { ArcGauge } from "arc-gauge.slint";

export component ChargeScreen inherits Rectangle {
    in property <int> battery-percent: 0;
    in property <string> charge-label: "Charging";
    callback dismissed();
    background: Theme.bg;

    // Full-circle charge dial, starting at 12 o'clock.
    ArcGauge {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: parent.height;
        thickness: 20px * Theme.scale;
        start-angle: 270deg;
        span-angle: 360deg;
        rounded-ends: false;
        track-color: Theme.track;
        indicator-color: Theme.accent;
        value: clamp(root.battery-percent / 100.0, 0, 1);
    }

    // ui_ChargeInfoContainer
    VerticalLayout {
        alignment: center;
        Text {
            text: root.charge-label;
            color: Theme.text;
            font-size: Theme.font-14;
            font-weight: Theme.w-semibold;
            horizontal-alignment: center;
        }
        Text {
            text: "\{root.battery-percent}%";
            color: Theme.text;
            font-size: Theme.font-14;
            font-weight: Theme.w-medium;
            font-family: Theme.font-mono;
            horizontal-alignment: center;
        }
        Text {
            text: "Tap to dismiss";
            color: Theme.text-dim;
            font-size: Theme.font-11;
            horizontal-alignment: center;
        }
    }
    TouchArea { clicked => { root.dismissed(); } }
}
