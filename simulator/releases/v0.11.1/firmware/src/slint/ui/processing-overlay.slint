import { Theme } from "theme.slint";

export component ProcessingOverlay inherits Rectangle {
    in property <string> message;
    background: #000000d0;
    TouchArea { clicked => {} }
    property <int> phase: 0;
    Timer {
        interval: 200ms;
        running: true;
        triggered => { root.phase = Math.mod(root.phase + 1, 3); }
    }
    VerticalLayout {
        padding-left: Theme.page-padding-horizontal;
        padding-right: Theme.page-padding-horizontal;
        alignment: center;
        spacing: 16px * Theme.scale;
        Text {
            text: root.message;
            color: Theme.text;
            font-size: Theme.font-14;
            font-weight: Theme.w-semibold;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 6px * Theme.scale;
            for index in 3: Rectangle {
                width: 7px * Theme.scale;
                height: self.width;
                border-radius: self.width / 2;
                background: root.phase == index ? Theme.accent : Theme.track;
            }
        }
    }
}
