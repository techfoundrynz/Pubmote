import { Theme } from "theme.slint";
import { Page } from "page.slint";
import { Pager, PagerDots } from "pager.slint";

// Page whose children are horizontally swipeable pages, with the indicator
// dots in a slim footer. total-pages must match the child count (components
// cannot count their children). Every child becomes a swipe page - a screen
// needing footer buttons alongside dots should build on Page with an explicit
// Pager and its own footer instead.
export component PagedPage inherits Page {
    in-out property <int> current-page: 0;
    in property <int> total-pages: 2;

    property <length> dots-footer: 24px * Theme.scale;
    footer-inset: dots-footer;

    // Forwarded so pages with their own gesture handling stay in sync
    public function set-drag(offset: length) { pager.set-drag(offset); }
    public function end-drag() { pager.end-drag(); }
    public function cancel-drag() { pager.cancel-drag(); }

    pager := Pager {
        current-page <=> root.current-page;
        total-pages: root.total-pages;
        @children
    }

    Rectangle {
        vertical-stretch: 0;
        height: root.dots-footer;
        background: Theme.bg;

        VerticalLayout {
            alignment: end;
            padding-bottom: 6px * Theme.scale;

            PagerDots {
                current-page: root.current-page;
                total-pages: root.total-pages;
            }
        }
    }
}
