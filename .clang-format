# Shared C/C++ style. VS Code's format-on-save reads this file via
# C_Cpp.clang_format_style in .vscode/settings.shared.json.
BasedOnStyle: Microsoft
IndentWidth: 2
ColumnLimit: 120
IndentPPDirectives: BeforeHash
BraceWrapping:
  AfterControlStatement: false
  AfterFunction: false
  AfterClass: false
  AfterStruct: false
  AfterEnum: false
